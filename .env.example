# --- platform ---
SITE_DOMAIN=yok.ninja
CLOUD_PROVIDER=aws
STORAGE_PROVIDER=aws
ARTIFACT_BASE_URL=https://YOUR_BUCKET.s3.YOUR_REGION.amazonaws.com/__output

# --- shared secrets ---
# Issue once via: POST /auth/bootstrap (first run) then POST /auth/tokens as the proxy user
PROXY_SERVICE_TOKEN=
BOOTSTRAP_SECRET=

# --- database ---
DATABASE_URL=
DIRECT_URL=

# --- kafka ---
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC=
# Optional TLS certificate authority for brokers that need one.
# When unset, the API and build server use TLS with the default trust store;
# set KAFKA_SSL=false on the build server only for plaintext brokers.
# KAFKA_CA_PATH=/app/ca.pem

# --- clickhouse ---
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=

# --- api tuning ---
# Deployments still active (QUEUED/IN_PROGRESS) after this many minutes are
# marked FAILED by a safety sweep in case a build task died without reporting.
# STALE_DEPLOYMENT_MINUTES=30

# --- aws compute (api -> ecs) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ECS_CLUSTER=
AWS_ECS_TASK_DEFINITION=
AWS_ECS_CONTAINER_NAME=
AWS_ECS_SUBNETS=subnet-aaa,subnet-bbb
AWS_ECS_SECURITY_GROUPS=sg-xxx

# --- aws storage (build-server) ---
AWS_S3_BUCKET=
