# Subset of the root .env.example consumed by the API server.
# docker-compose passes these through from the root .env file.

PORT=9000

# --- platform ---
SITE_DOMAIN=yok.ninja
CLOUD_PROVIDER=aws

# --- shared secrets ---
PROXY_SERVICE_TOKEN=
BOOTSTRAP_SECRET=

# --- database ---
DATABASE_URL=
DIRECT_URL=

# --- kafka ---
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC=
# KAFKA_CA_PATH=/app/ca.pem

# --- clickhouse ---
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=

# --- aws compute (api -> ecs) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ECS_CLUSTER=
AWS_ECS_TASK_DEFINITION=
AWS_ECS_CONTAINER_NAME=
AWS_ECS_SUBNETS=subnet-aaa,subnet-bbb
AWS_ECS_SECURITY_GROUPS=sg-xxx
