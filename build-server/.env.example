# Subset of the root .env.example consumed by the build server.
# The build server runs as an ECS task (not in docker-compose), so these are
# set in the task definition. PROJECT_ID, DEPLOYMENT_ID, GIT_REPO_URL and
# FRAMEWORK are injected per-task by the API's ComputeProvider at run time.

# --- platform ---
STORAGE_PROVIDER=aws

# --- kafka ---
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC=
# KAFKA_CA_PATH=/app/ca.pem

# --- aws storage ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional override of the artifact key prefix; must match the suffix of
# ARTIFACT_BASE_URL (default: __output).
# OUTPUT_PREFIX=__output
